# --- Supabase (project: lithia-wallet-scorecards) ---
SUPABASE_URL=https://ropvfkjkpcqiwgqfmzfz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Public base URL of this service (Render gives you this) ---
PUBLIC_BASE_URL=https://lithia-wallet-scorecards.onrender.com

# --- Apple Wallet ---
APPLE_TEAM_ID=A63L38TNCC
APPLE_PASS_TYPE_ID=pass.com.alphadriveai.lithia.scorecard
# Path to the Pass Type ID certificate exported from Keychain (Render Secret File)
APPLE_PASS_P12_PATH=/etc/secrets/lithia-scorecard.p12
APPLE_PASS_P12_PASSWORD=
# APNs auth key (Render Secret File)
APPLE_APNS_KEY_PATH=/etc/secrets/AuthKey_3BH6593MS4.p8
APPLE_APNS_KEY_ID=3BH6593MS4

# --- Security ---
# Shared secret Supabase sends in the x-webhook-secret header
WEBHOOK_SECRET=
# Key the admin app sends in x-admin-key for manual pushes
ADMIN_API_KEY=

# --- Behaviour ---
# true = RMOs get a visible "Scorecard updated" notification on change; false = silent refresh
NOTIFY_ON_CHANGE=false
PORT=10000
